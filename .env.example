# Shared app config

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Configure a paid model or an OpenRouter BYOK route for durable fallback.
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_FALLBACK_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_TOKENS_PER_MINUTE=60000
OPENROUTER_TOKENS_PER_MINUTE=0
LLM_SUMMARY_MAX_COMPLETION_TOKENS=6000
LLM_REPAIR_MAX_COMPLETION_TOKENS=3500
LLM_TOPIC_MAX_COMPLETION_TOKENS=2000
LLM_TRANSLATION_MAX_COMPLETION_TOKENS=3000
LLM_DECISION_MAX_COMPLETION_TOKENS=2500
# Temporary compatibility only: secondary keys often share the same provider quota.
LLM_ENABLE_LEGACY_KEY_ROTATION=false
SUMMARY_RETRY_BASE_MS=300000
SUMMARY_RETRY_MAX_MS=21600000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=change-me-to-a-strong-password
RATE_LIMIT_SECRET=change-me-to-an-independent-random-secret
SUPABASE_CRON_SECRET=
SCRAPE_API_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="SimpleCity <updates@simplecity.app>"
RESEND_REPLY_TO_EMAIL=

# North San Mateo database
# Foster City, San Mateo, and San Mateo County

